---
import { identity } from '../data/profile';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="container-page flex flex-col gap-4 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <div class="space-y-1">
      <p>Views expressed are personal.</p>
      <p>&copy; {year} {identity.name}. All rights reserved.</p>
    </div>
    <div class="flex items-center gap-5">
      <a href="/rss.xml" class="inline-flex items-center gap-1.5 hover:text-accent">
        <Icon name="rss" size={16} /> RSS
      </a>
      <a
        href={identity.linkedin}
        class="inline-flex items-center gap-1.5 hover:text-accent"
        rel="me noopener"
        target="_blank"
      >
        <Icon name="linkedin" size={16} /> LinkedIn<span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>
  </div>
</footer>
