---
import { Picture } from 'astro:assets';
import heroPhoto from '../assets/images/profile-hero.jpg';
import { identity, currentRoles, stats } from '../data/profile';
import { siteConfig } from '../site.config';
import Icon from './Icon.astro';

// "Title | Area | Area" → main title + focus-area chips.
const [primaryTitle, ...focusAreas] = identity.headline.split('|').map((s) => s.trim());

// Split the main title around the highlighted words.
const hi = identity.headlineHighlight;
const hiAt = hi ? primaryTitle.indexOf(hi) : -1;
const titleParts =
  hiAt >= 0
    ? { before: primaryTitle.slice(0, hiAt), hi, after: primaryTitle.slice(hiAt + hi.length) }
    : { before: primaryTitle, hi: '', after: '' };

const badge = stats[0];
const rail = [
  { icon: 'linkedin', label: 'LinkedIn', href: identity.linkedin, external: true },
  { icon: 'mail', label: 'Email', href: `mailto:${identity.email}` },
  { icon: 'phone', label: 'Phone', href: `tel:${identity.phone}` },
];
---

<section class="container-page pt-6 pb-10 sm:pt-10 sm:pb-14" aria-labelledby="hero-title">
  <div
    class="relative grid overflow-hidden rounded-3xl bg-hero text-white lg:grid-cols-12 dark:ring-1 dark:ring-white/10 [&_:focus-visible]:outline-highlight"
  >
    <!-- Photo -->
    <div class="relative lg:order-last lg:col-span-5">
      <Picture
        src={heroPhoto}
        alt={`Portrait of ${identity.name} speaking at a conference`}
        formats={['avif', 'webp']}
        widths={[400, 646]}
        sizes="(min-width: 1024px) 460px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/3] w-full object-cover object-[50%_22%] sm:aspect-[16/10] lg:absolute lg:inset-0 lg:aspect-auto lg:h-full"
      />
      <!-- Soft fade from panel into photo on wide screens -->
      <div
        class="pointer-events-none absolute inset-y-0 left-0 hidden w-24 bg-gradient-to-r from-hero to-transparent lg:block"
        aria-hidden="true"
      >
      </div>
      <!-- Leaf accent -->
      <span
        class="absolute -bottom-6 left-6 z-10 size-12 rounded-[0_60%_0_60%] bg-highlight lg:bottom-16 lg:-left-7 lg:size-14"
        aria-hidden="true"></span>
      <!-- Floating stat badge -->
      <div
        class="absolute right-4 bottom-4 hidden rounded-xl bg-white/95 px-4 py-3 text-[#1a1f29] shadow-lg sm:block lg:right-6 lg:bottom-6"
      >
        <p class="text-2xl leading-none font-semibold" style={`color: ${siteConfig.accent}`}>{badge.value}</p>
        <p class="mt-1 text-xs text-[#4f5866]">{badge.label}</p>
      </div>
    </div>

    <!-- Text panel -->
    <div class="relative px-6 pt-12 pb-10 sm:px-10 sm:pb-14 lg:col-span-7 lg:py-20 lg:pr-12 lg:pl-24">
      <!-- Dashed decorative curve -->
      <svg
        class="pointer-events-none absolute inset-0 h-full w-full text-highlight opacity-30"
        viewBox="0 0 600 600"
        preserveAspectRatio="none"
        fill="none"
        aria-hidden="true"
      >
        <path d="M-20 590 C 120 520, 140 420, 260 400 S 420 300, 470 170 S 560 40, 640 20" stroke="currentColor" stroke-width="1.2" stroke-dasharray="6 9" vector-effect="non-scaling-stroke"></path>
      </svg>

      <!-- Contact rail -->
      <nav aria-label="Contact links" class="absolute inset-y-0 left-8 hidden flex-col items-center justify-center gap-5 lg:flex">
        <span class="h-14 w-px bg-white/20" aria-hidden="true"></span>
        {
          rail.map((r) => (
            <a
              href={r.href}
              aria-label={r.label}
              class="text-white/60 transition-colors hover:text-highlight"
              {...(r.external ? { target: '_blank', rel: 'me noopener' } : {})}
            >
              <Icon name={r.icon} size={18} />
            </a>
          ))
        }
        <span class="h-14 w-px bg-white/20" aria-hidden="true"></span>
      </nav>

      <div class="relative">
        <p class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-[0.14em] text-white/70 uppercase">
          <Icon name="pin" size={14} />
          {identity.location}
        </p>
        <p class="mt-5 text-lg text-white/85 sm:text-xl">Hello, I’m</p>
        <h1 id="hero-title" class="mt-1 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
          {identity.name}
        </h1>
        <p class="mt-4 text-2xl leading-snug font-semibold tracking-tight text-balance sm:text-3xl">
          {titleParts.before}<span class="text-highlight">{titleParts.hi}</span>{titleParts.after}
        </p>

        <ul class="mt-5 flex flex-wrap gap-2" aria-label="Focus areas">
          {
            focusAreas.map((area) => (
              <li class="rounded-full border border-white/20 px-3 py-1 text-xs font-medium text-white/80">{area}</li>
            ))
          }
        </ul>

        <p class="mt-7 border-l-2 border-highlight pl-4 text-lg leading-relaxed text-pretty text-white/90">
          {identity.tagline}
        </p>

        <ul class="mt-6 space-y-2 text-sm text-white/75" aria-label="Current roles">
          {
            currentRoles.map((role) => (
              <li class="flex gap-2">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-highlight" aria-hidden="true" />
                <span>
                  <span class="font-medium text-white">{role.title}</span>, {role.org}
                </span>
              </li>
            ))
          }
        </ul>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#contact"
            class="btn bg-highlight font-semibold hover:opacity-90"
            style={`color: ${siteConfig.accent}`}
          >
            Get in touch
          </a>
          <a href={siteConfig.cvPath} class="btn border border-white/30 text-white hover:bg-white/10" download>
            <Icon name="download" size={16} /> Download CV
          </a>
          <a
            href={identity.linkedin}
            class="btn text-white/85 hover:text-highlight lg:hidden"
            rel="me noopener"
            target="_blank"
          >
            <Icon name="linkedin" size={16} /> LinkedIn<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
