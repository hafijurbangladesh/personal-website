---
import { Picture } from 'astro:assets';
import profilePhoto from '../assets/images/profile.jpg';
import { identity, currentRoles } from '../data/profile';
import { siteConfig } from '../site.config';
import Icon from './Icon.astro';

// "Title | Area | Area" → main title + focus-area chips.
const [primaryTitle, ...focusAreas] = identity.headline.split('|').map((s) => s.trim());
---

<section class="container-page pt-12 pb-14 sm:pt-20 sm:pb-20" aria-labelledby="hero-title">
  <div class="flex flex-col-reverse gap-10 md:flex-row md:items-center md:justify-between md:gap-14">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4 inline-flex items-center gap-1.5">
        <Icon name="pin" size={14} />
        {identity.location}
      </p>
      <h1 id="hero-title" class="text-4xl font-semibold tracking-tight text-ink sm:text-5xl">{identity.name}</h1>
      <p class="mt-3 text-lg font-medium text-ink sm:text-xl">{primaryTitle}</p>
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Focus areas">
        {
          focusAreas.map((area) => (
            <li class="rounded-full border border-line bg-surface px-3 py-1 text-xs font-medium text-muted">{area}</li>
          ))
        }
      </ul>

      <p class="mt-7 border-l-2 border-accent pl-4 text-lg leading-relaxed text-ink sm:text-xl">
        {identity.tagline}
      </p>

      <ul class="mt-7 space-y-2 text-sm text-muted" aria-label="Current roles">
        {
          currentRoles.map((role) => (
            <li class="flex gap-2">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              <span>
                <span class="font-medium text-ink">{role.title}</span>, {role.org}
              </span>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={siteConfig.cvPath} class="btn btn-primary" download>
          <Icon name="download" size={16} /> Download CV
        </a>
        <a href="#contact" class="btn btn-secondary">Get in touch</a>
        <a href={identity.linkedin} class="btn btn-secondary" rel="me noopener" target="_blank">
          <Icon name="linkedin" size={16} /> LinkedIn<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </div>

    <div class="shrink-0">
      <Picture
        src={profilePhoto}
        alt={`Portrait of ${identity.name}`}
        formats={['avif', 'webp']}
        width={440}
        height={440}
        widths={[160, 220, 320, 440]}
        sizes="(min-width: 768px) 220px, 160px"
        loading="eager"
        fetchpriority="high"
        class="size-40 rounded-full object-cover p-1 ring-2 ring-accent md:size-[220px]"
      />
    </div>
  </div>
</section>
