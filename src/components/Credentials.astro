---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { education, certifications, memberships } from '../data/profile';
---

<Section id="credentials" eyebrow="Credentials" title="Education, certifications and memberships">
  <div class="grid gap-4 md:grid-cols-3">
    <div class="card p-6">
      <h3 class="flex items-center gap-2 font-semibold text-ink">
        <Icon name="cap" class="text-accent" /> Education
      </h3>
      <ul class="mt-4 space-y-4">
        {
          education.map((e) => (
            <li>
              <p class="text-sm font-medium text-ink">{e.degree}</p>
              <p class="text-sm text-muted">{e.institution}</p>
              <p class="text-xs text-muted">{e.period}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="card p-6">
      <h3 class="flex items-center gap-2 font-semibold text-ink">
        <Icon name="award" class="text-accent" /> Certifications
      </h3>
      <ul class="mt-4 space-y-2.5">
        {
          certifications.map((c) => (
            <li class="flex items-baseline justify-between gap-3 text-sm">
              <span class="text-ink">{c.name}</span>
              {c.year && <span class="shrink-0 text-xs text-muted">{c.year}</span>}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="card p-6">
      <h3 class="flex items-center gap-2 font-semibold text-ink">
        <Icon name="users" class="text-accent" /> Memberships
      </h3>
      <ul class="mt-4 space-y-4">
        {
          memberships.map((m) => (
            <li>
              <p class="text-sm font-medium text-ink">{m.org}</p>
              <p class="text-sm text-muted">{m.role}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
