---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';

interface Props {
  post: CollectionEntry<'insights'>;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel: Heading = 'h3' } = Astro.props;
---

<article class="card group relative flex h-full flex-col p-6 transition-colors hover:border-accent">
  <time datetime={post.data.pubDate.toISOString()} class="text-xs font-medium text-muted">
    {formatDate(post.data.pubDate)}
  </time>
  <Heading class="mt-2 font-semibold text-ink group-hover:text-accent">
    <a href={`/insights/${post.id}/`} class="after:absolute after:inset-0">{post.data.title}</a>
  </Heading>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{post.data.description}</p>
  {
    post.data.tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tags">
        {post.data.tags.map((t) => (
          <li class="rounded-full bg-accent-soft px-2.5 py-0.5 text-xs text-accent">{t}</li>
        ))}
      </ul>
    )
  }
</article>
