---
import Section from './Section.astro';
import RoleItem from './RoleItem.astro';
import { experience } from '../data/profile';

/** Roles shown before the "earlier roles" disclosure. */
const VISIBLE = 6;
const recent = experience.slice(0, VISIBLE);
const earlier = experience.slice(VISIBLE);
---

<Section id="experience" eyebrow="Experience" title="Career timeline">
  <ol class="relative ml-1.5 border-l border-line">
    {recent.map((role) => <RoleItem role={role} />)}
  </ol>

  {
    earlier.length > 0 && (
      <details class="group mt-2">
        <summary class="inline-flex cursor-pointer list-none items-center gap-2 rounded-md py-2 text-sm font-medium text-accent [&::-webkit-details-marker]:hidden">
          <span class="group-open:hidden">Show {earlier.length} earlier roles</span>
          <span class="hidden group-open:inline">Hide earlier roles</span>
        </summary>
        <ol class="relative mt-6 ml-1.5 border-l border-line">
          {earlier.map((role) => (
            <RoleItem role={role} />
          ))}
        </ol>
      </details>
    )
  }
</Section>
