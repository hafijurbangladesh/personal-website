---
import { stats } from '../data/profile';
---

<section aria-label="Impact in numbers" class="border-y border-line bg-surface">
  <dl class="container-page grid grid-cols-2 gap-x-6 gap-y-8 py-10 sm:grid-cols-3 lg:grid-cols-5">
    {
      stats.map((stat) => (
        <div class="flex flex-col gap-1">
          <dt class="text-sm leading-snug text-muted">{stat.label}</dt>
          <dd class="order-first text-3xl font-semibold tracking-tight text-accent">{stat.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
