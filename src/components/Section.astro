---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  class?: string;
}

const { id, eyebrow, title, intro, class: className } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class:list={['container-page py-16 sm:py-20', className]}>
  <header class="mb-10 max-w-2xl">
    {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
    <h2 id={`${id}-title`} class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">{title}</h2>
    {intro && <p class="mt-3 text-muted">{intro}</p>}
  </header>
  <slot />
</section>
