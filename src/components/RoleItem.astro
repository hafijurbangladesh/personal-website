---
import type { Role } from '../data/profile';

interface Props {
  role: Role;
}

const { role } = Astro.props;
const current = role.end === 'Present';
---

<li class="relative pb-10 pl-6 last:pb-2">
  <span
    class:list={[
      'absolute top-1.5 -left-[5px] size-[9px] rounded-full border-2',
      current ? 'border-accent bg-accent' : 'border-line bg-bg',
    ]}
    aria-hidden="true"></span>
  <p class="text-xs font-medium tracking-wide text-muted uppercase">
    {role.start} – {role.end}
  </p>
  <h3 class="mt-1 font-semibold text-ink">
    {role.title} <span class="font-normal text-muted">· {role.org}</span>
  </h3>
  {
    role.highlights && (
      <ul class="mt-3 max-w-3xl list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-muted marker:text-line">
        {role.highlights.map((h) => (
          <li>{h}</li>
        ))}
      </ul>
    )
  }
</li>
