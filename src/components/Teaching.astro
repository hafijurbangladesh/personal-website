---
import Section from './Section.astro';
import { teaching } from '../data/profile';
---

<Section id="teaching" eyebrow="Teaching" title="Bridging practice and academia" intro={teaching.intro}>
  <div class="grid gap-4 md:grid-cols-2">
    <ul class="card divide-y divide-line">
      {
        teaching.positions.map((p) => (
          <li class="p-6">
            <p class="text-xs font-medium tracking-wide text-muted uppercase">{p.period}</p>
            <h3 class="mt-1 font-semibold text-ink">{p.title}</h3>
            <p class="text-sm text-muted">{p.institution}</p>
          </li>
        ))
      }
    </ul>
    <div class="card p-6">
      <h3 class="font-semibold text-ink">Focus</h3>
      <ul class="mt-4 space-y-3">
        {
          teaching.focus.map((f) => (
            <li class="flex gap-3 text-sm leading-relaxed text-muted">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              {f}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
