---
import { siteConfig } from '../site.config';
import { identity } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
  <nav class="container-page flex h-16 items-center justify-between gap-4" aria-label="Main">
    <a href="/" class="text-[15px] font-semibold tracking-tight text-ink hover:text-accent">
      {identity.name}
    </a>

    <div class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 md:flex">
        {
          siteConfig.nav.map((item) => (
            <li>
              <a href={item.href} class="rounded-md px-3 py-2 text-sm text-muted hover:text-accent">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
      <button
        type="button"
        class="inline-flex size-9 items-center justify-center rounded-md text-muted hover:bg-accent-soft hover:text-accent md:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
        data-menu-button
      >
        <Icon name="menu" data-icon-open />
        <Icon name="close" class="hidden" data-icon-close />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line bg-bg md:hidden" data-menu>
    <ul class="container-page flex flex-col py-3">
      {
        siteConfig.nav.map((item) => (
          <li>
            <a href={item.href} class="block rounded-md px-2 py-3 text-base text-ink hover:text-accent">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (button && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      button.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      button.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
    };
    button.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        setOpen(false);
        button.focus();
      }
    });
  }
</script>
