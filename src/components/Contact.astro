---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { identity } from '../data/profile';
import { siteConfig } from '../site.config';

const formId = siteConfig.formspreeId?.trim();
const mailto = `mailto:${identity.email}?subject=${encodeURIComponent('Enquiry via website')}`;
const field =
  'mt-1.5 block w-full rounded-md border border-line bg-bg px-3 py-2.5 text-sm text-ink placeholder:text-muted/70 focus:border-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/30';
---

<Section
  id="contact"
  eyebrow="Contact"
  title="Let’s work together"
  intro="Open to national and international collaboration on DPI, GovTech, AI-enabled government, enterprise architecture and interoperability."
>
  <div class="grid gap-6 md:grid-cols-5">
    <ul class="card space-y-5 p-6 md:col-span-2">
      <li class="flex gap-3">
        <Icon name="mail" class="mt-0.5 shrink-0 text-accent" />
        <div>
          <p class="text-xs text-muted">Email</p>
          <a href={`mailto:${identity.email}`} class="text-sm break-all text-ink hover:text-accent">{identity.email}</a>
        </div>
      </li>
      <li class="flex gap-3">
        <Icon name="phone" class="mt-0.5 shrink-0 text-accent" />
        <div>
          <p class="text-xs text-muted">Phone</p>
          <a href={`tel:${identity.phone}`} class="text-sm text-ink hover:text-accent">{identity.phoneDisplay}</a>
        </div>
      </li>
      <li class="flex gap-3">
        <Icon name="linkedin" class="mt-0.5 shrink-0 text-accent" />
        <div>
          <p class="text-xs text-muted">LinkedIn</p>
          <a href={identity.linkedin} class="text-sm text-ink hover:text-accent" rel="me noopener" target="_blank">
            hafijur-bangladesh<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
      </li>
      <li class="flex gap-3">
        <Icon name="pin" class="mt-0.5 shrink-0 text-accent" />
        <div>
          <p class="text-xs text-muted">Location</p>
          <p class="text-sm text-ink">{identity.location}</p>
        </div>
      </li>
    </ul>

    <div class="card p-6 md:col-span-3">
      {
        formId ? (
          <form action={`https://formspree.io/f/${formId}`} method="POST" class="space-y-4">
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="cf-name" class="text-sm font-medium text-ink">Name</label>
                <input id="cf-name" name="name" type="text" autocomplete="name" required class={field} />
              </div>
              <div>
                <label for="cf-email" class="text-sm font-medium text-ink">Email</label>
                <input id="cf-email" name="email" type="email" autocomplete="email" required class={field} />
              </div>
            </div>
            <div>
              <label for="cf-org" class="text-sm font-medium text-ink">
                Organisation <span class="font-normal text-muted">(optional)</span>
              </label>
              <input id="cf-org" name="organisation" type="text" autocomplete="organization" class={field} />
            </div>
            <div>
              <label for="cf-message" class="text-sm font-medium text-ink">Message</label>
              <textarea id="cf-message" name="message" rows="5" required class={field} />
            </div>
            <input type="hidden" name="_subject" value="New enquiry from your website" />
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
            <div class="flex flex-wrap items-center gap-4">
              <button type="submit" class="btn btn-primary">Send message</button>
              <p class="text-xs text-muted">
                Or email me directly at <a href={mailto} class="link">{identity.email}</a>.
              </p>
            </div>
          </form>
        ) : (
          <div class="flex h-full flex-col justify-center">
            <h3 class="font-semibold text-ink">Send me a message</h3>
            <p class="mt-2 text-sm text-muted">
              The quickest way to reach me is by email or LinkedIn.
            </p>
            <a href={mailto} class="btn btn-primary mt-5 self-start">
              <Icon name="mail" size={16} /> Send an email
            </a>
          </div>
        )
      }
    </div>
  </div>
</Section>
