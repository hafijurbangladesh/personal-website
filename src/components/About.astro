---
import Section from './Section.astro';
import { about } from '../data/profile';
---

<Section id="about" eyebrow="About" title="Building digital government that works for citizens" split>
  <div class="space-y-5 text-[17px] leading-relaxed text-pretty text-ink">
    {about.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</Section>
