---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  /** Short facts shown in the sidebar, e.g. role or publication date. */
  details?: { label: string; value: string }[];
  tags?: string[];
  backHref: string;
  backLabel: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  eyebrow,
  details = [],
  tags = [],
  backHref,
  backLabel,
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  jsonLd={jsonLd}
>
  <article class="container-page pt-10 pb-8 sm:pt-14">
    <nav aria-label="Breadcrumb">
      <a href={backHref} class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-accent">
        <Icon name="back" size={16} />
        {backLabel}
      </a>
    </nav>
    <header class="mt-8 max-w-3xl">
      {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
      <h1 class="text-3xl font-semibold tracking-tight text-balance text-ink sm:text-4xl">{title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-pretty text-muted">{description}</p>
    </header>

    <div class="mt-10 border-t border-line pt-10 lg:grid lg:grid-cols-12 lg:gap-12">
      <div
        class="prose prose-site max-w-none lg:col-span-8 prose-headings:font-semibold prose-headings:tracking-tight prose-a:underline-offset-4"
      >
        <slot />
      </div>

      <aside class="mt-12 lg:sticky lg:top-24 lg:col-span-4 lg:mt-0 lg:self-start">
        <div class="card space-y-5 p-6">
          {
            details.map((d) => (
              <div>
                <p class="text-xs font-medium tracking-wide text-muted uppercase">{d.label}</p>
                <p class="mt-1 text-sm text-ink">{d.value}</p>
              </div>
            ))
          }
          {
            tags.length > 0 && (
              <div>
                <p class="text-xs font-medium tracking-wide text-muted uppercase">Topics</p>
                <ul class="mt-2 flex flex-wrap gap-1.5">
                  {tags.map((t) => (
                    <li class="rounded-full bg-accent-soft px-2.5 py-0.5 text-xs text-accent">{t}</li>
                  ))}
                </ul>
              </div>
            )
          }
          <div class:list={[(details.length > 0 || tags.length > 0) && 'border-t border-line pt-5']}>
            <p class="text-sm text-muted">Want to discuss this?</p>
            <a href="/#contact" class="btn btn-primary mt-3 w-full">Get in touch</a>
          </div>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
