---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { identity } from '../data/profile';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  meta?: string;
  backHref: string;
  backLabel: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, eyebrow, meta, backHref, backLabel, publishedTime, modifiedTime, jsonLd } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  jsonLd={jsonLd}
>
  <article class="container-page pt-10 pb-8 sm:pt-14">
    <nav aria-label="Breadcrumb">
      <a href={backHref} class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-accent">
        <Icon name="back" size={16} />
        {backLabel}
      </a>
    </nav>
    <header class="mt-8 max-w-3xl">
      {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
      <h1 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">{title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">{description}</p>
      {meta && <p class="mt-4 text-sm text-muted">{meta}</p>}
    </header>
    <div
      class="prose prose-site mt-10 max-w-3xl border-t border-line pt-10 prose-headings:font-semibold prose-headings:tracking-tight prose-a:underline-offset-4"
    >
      <slot />
    </div>
    <footer class="mt-14 max-w-3xl border-t border-line pt-8">
      <p class="text-sm text-muted">
        Want to discuss this? <a href="/#contact" class="link">Get in touch with {identity.shortName}</a>.
      </p>
    </footer>
  </article>
</BaseLayout>
