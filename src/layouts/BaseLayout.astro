---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  /** Structured data objects rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>[];
}

const { jsonLd = [], ...seo } = Astro.props;
---

<!doctype html>
<html lang="en" style={`--brand: ${siteConfig.accent}; --highlight: ${siteConfig.highlight}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1218" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} — Insights`} href="/rss.xml" />
    <Seo {...seo} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <script is:inline>
      // Apply the saved or system colour theme before first paint (avoids a flash).
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
    {
      siteConfig.cfBeaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: siteConfig.cfBeaconToken })}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
