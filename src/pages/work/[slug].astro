---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPublishedWork } from '../../lib/content';

export async function getStaticPaths() {
  const work = await getPublishedWork();
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// meta is "Role · Organisation · Period".
const [role, org, period] = (entry.data.meta ?? '').split(' · ');
const details = [
  { label: 'Role', value: role },
  { label: 'Organisation', value: org },
  { label: 'Period', value: period },
].filter((d) => d.value);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.summary}
  eyebrow="Case study"
  details={details}
  tags={entry.data.tags}
  backHref="/#work"
  backLabel="All selected work"
>
  <Content />
</ArticleLayout>
