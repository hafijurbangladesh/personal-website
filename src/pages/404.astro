---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="container-page flex flex-col items-start py-24 sm:py-32">
    <p class="eyebrow mb-3">Error 404</p>
    <h1 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Page not found</h1>
    <p class="mt-4 max-w-xl text-muted">The page you were looking for has moved or no longer exists.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Back to home</a>
      <a href="/insights/" class="btn btn-secondary">Read insights</a>
    </div>
  </section>
</BaseLayout>
