---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InsightCard from '../../components/InsightCard.astro';
import Icon from '../../components/Icon.astro';
import { getPublishedInsights } from '../../lib/content';

const posts = await getPublishedInsights();
const description = 'Notes and perspectives on Digital Public Infrastructure, GovTech and responsible AI in government.';
---

<BaseLayout title="Insights" description={description}>
  <section class="container-page pt-12 pb-8 sm:pt-16" aria-labelledby="insights-title">
    <p class="eyebrow mb-3">Insights</p>
    <h1 id="insights-title" class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Insights</h1>
    <p class="mt-3 max-w-2xl text-muted">{description}</p>
    <a href="/rss.xml" class="mt-4 inline-flex items-center gap-1.5 text-sm text-accent hover:underline">
      <Icon name="rss" size={16} /> Subscribe via RSS
    </a>

    {
      posts.length > 0 ? (
        <ul class="mt-10 grid gap-4 md:grid-cols-2">
          {posts.map((post) => (
            <li>
              <InsightCard post={post} headingLevel="h2" />
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-10 text-muted">New articles are coming soon.</p>
      )
    }
  </section>
</BaseLayout>
