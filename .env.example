# Copy to .env for local builds, and set the same variables in Cloudflare Pages → Settings → Environment variables.

# Canonical site URL (no trailing slash). Used for canonical links, sitemap, RSS and Open Graph.
SITE_URL=https://example.com

# Formspree form ID (the part after https://formspree.io/f/). Leave empty to show a mailto: link instead.
PUBLIC_FORMSPREE_ID=

# Cloudflare Web Analytics beacon token. Leave empty to disable analytics.
PUBLIC_CF_BEACON_TOKEN=
